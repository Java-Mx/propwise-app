{
  "name": "Analysis",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "default": ""
    },
    "owner_name": {
      "type": "string",
      "default": ""
    },
    "owner_email": {
      "type": "string",
      "default": ""
    },
    "property_location": {
      "type": "string",
      "default": ""
    },
    "property_type": {
      "type": "string",
      "default": "Apartment"
    },
    "property_price": {
      "type": "number",
      "default": 0
    },
    "amount_saved": {
      "type": "number",
      "default": 0
    },
    "home_loan_percentage": {
      "type": "number",
      "default": 0
    },
    "monthly_income": {
      "type": "number",
      "default": 0
    },
    "existing_emi": {
      "type": "number",
      "default": 0
    },
    "interest_rate": {
      "type": "number",
      "default": 0
    },
    "loan_tenure_years": {
      "type": "number",
      "default": 0
    },
    "costs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "section": {
            "type": "string",
            "enum": [
              "monthly",
              "annual",
              "onetime"
            ]
          },
          "category": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "default": 0
          },
          "frequency": {
            "type": "string",
            "enum": [
              "Monthly",
              "Quarterly",
              "Half-Yearly",
              "Yearly",
              "One-Time"
            ]
          }
        }
      },
      "default": []
    },
    "monthly_rent": {
      "type": "number",
      "default": 0
    },
    "annual_rent_increase": {
      "type": "number",
      "default": 0
    },
    "vacancy_rate": {
      "type": "number",
      "default": 0
    },
    "annual_rental_maintenance": {
      "type": "number",
      "default": 0
    },
    "other_rental_costs": {
      "type": "number",
      "default": 0
    },
    "annual_appreciation": {
      "type": "number",
      "default": 0
    },
    "projection_years": {
      "type": "number",
      "default": 0
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "property_price": {
            "type": "number",
            "default": 0
          },
          "amount_saved": {
            "type": "number",
            "default": 0
          },
          "home_loan_percentage": {
            "type": "number",
            "default": 0
          },
          "interest_rate": {
            "type": "number",
            "default": 0
          },
          "loan_tenure_years": {
            "type": "number",
            "default": 0
          },
          "monthly_rent": {
            "type": "number",
            "default": 0
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}